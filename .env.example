# ==============================================================================
# HederaEdge Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your Hedera Developer Portal
# credentials: https://portal.hedera.com
# ==============================================================================

# Hedera Network ('testnet', 'mainnet', 'previewnet')
HEDERA_NETWORK=testnet

# Gateway Operator / Submitting Account ID (e.g., 0.0.1234567)
HEDERA_ACCOUNT_ID=0.0.11335112

# ECDSA or ED25519 Private Key for the operator account (Hex encoded or DER)
HEDERA_PRIVATE_KEY=your_private_key_here

# HCS Consensus Service Topic ID for telemetry & inference proofs
# Deployed Testnet Topic: 0.0.11335841
HCS_TOPIC_ID=0.0.11335841

# HTS Fungible Utility Token ID ($EDGE) for node reward payouts and fee staking
# Deployed Testnet Token: 0.0.11336302
EDGE_TOKEN_ID=0.0.11336302

# HTS Non-Fungible Token ID (HENFT) for hardware node security identity licenses
# Deployed Testnet NFT: 0.0.11336303
NODE_NFT_ID=0.0.11336303

# Hedera Smart Contract Service (HSCS) SLA Registry Contract
# Deployed Testnet Contract: 0.0.11337652
SLA_CONTRACT_ID=0.0.11337652

# Local Node Execution (Optional override for local agent)
# NEXT_PUBLIC_LOCAL_AGENT_URL=http://127.0.0.1:8000
